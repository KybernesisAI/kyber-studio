# Normalise line endings in the repository, whatever a working copy uses.
#
# There was no .gitattributes at all until KYB-588, which meant every text file
# was at the mercy of core.autocrlf on whichever machine committed it. That is
# not cosmetic here: build/linux/deb-postinst.sh and deb-postrm.sh are run by
# dpkg on the user's machine, and a CRLF shebang makes the interpreter lookup
# fail with a message naming a program nobody typed.

* text=auto eol=lf

# Scripts executed by the operating system. LF regardless of platform.
*.sh            text eol=lf
*.mjs           text eol=lf

# Binary, never line-ending-mangled and never diffed as text.
*.png           binary
*.icns          binary
*.ico           binary
*.node          binary
*.onnx          binary
*.wasm          binary
*.bin           binary

# Generated — kept out of language statistics, but NOT out of diffs. Marking it
# `-diff` renders it as "Bin 306695 -> 307521 bytes" in review, which is how an
# unintended dependency change gets waved through.
package-lock.json  linguist-generated
