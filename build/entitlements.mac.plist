<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <!-- Electron under the hardened runtime needs JIT + writable/executable
         memory for V8. Required for notarization to succeed. -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <key>com.apple.security.cs.allow-dyld-environment-variables</key>
    <true/>
    <!-- The app spawns child processes (eve dev, vercel CLI, gh). -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
    <!-- Dictation records from the microphone. Under the hardened runtime the
         OS refuses getUserMedia without this, and the refusal reaches the
         renderer as an ordinary media error, so a signed build looked like a
         machine with no microphone (KYB-540). Unsigned dev builds never showed
         it, because the hardened runtime is only applied when packaging. -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
    <key>com.apple.security.inherit</key>
    <true/>
  </dict>
</plist>
